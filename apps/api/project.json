{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig apps/api/tsconfig.app.json apps/api/src/main.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.app.json" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.app.json --noEmit" }
    }
  }
}
