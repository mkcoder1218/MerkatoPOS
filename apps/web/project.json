{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev apps/web -p 3000" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "next build apps/web" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/web/tsconfig.json --noEmit" }
    }
  }
}
