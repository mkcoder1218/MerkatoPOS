{
  "name": "merkatopos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "nx run-many -t serve --projects=web,api --parallel=2",
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm db:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "prisma generate --schema packages/database/prisma/schema",
    "db:validate": "prisma validate --schema packages/database/prisma/schema",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema",
    "db:seed": "tsx packages/database/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.16.3",
    "@tanstack/react-query": "^5.90.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "nx": "^21.5.3",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
