enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  displayOrder Int     @default(0)
  posVisible  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      Product[]
  kitchenRoutes KitchenPrintRoute[]

  @@unique([tenantId, name])
  @@index([tenantId, displayOrder])
  @@map("categories")
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        Product[]
  inventoryItems  InventoryItem[]
  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")
  orderItems      OrderItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, symbol])
  @@index([tenantId])
  @@map("units")
}

model UnitConversion {
  id         String   @id @default(cuid())
  tenantId   String
  fromUnitId String
  toUnitId   String
  multiplier Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUnit Unit   @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   Unit   @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromUnitId, toUnitId])
  @@index([tenantId])
  @@map("unit_conversions")
}

model TaxProfile {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  percentage Decimal  @db.Decimal(5, 2)
  mode       TaxMode
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("tax_profiles")
}

model Product {
  id             String   @id @default(cuid())
  tenantId       String
  categoryId     String
  unitId         String
  taxProfileId   String?
  name           String
  sku            String?
  barcode        String?
  sellingPrice   Decimal  @db.Decimal(18, 2)
  taxExempt      Boolean  @default(false)
  trackInventory Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxProfile     TaxProfile?            @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)
  branches       ProductBranch[]
  modifierGroups ProductModifierGroup[]
  discounts      ProductDiscount[]
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  kitchenRoutes  KitchenPrintRoute[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductBranch {
  productId     String
  branchId      String
  isAvailable   Boolean @default(true)
  priceOverride Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([productId, branchId])
  @@index([branchId])
  @@map("product_branches")
}
